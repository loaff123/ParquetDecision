include README.md LICENSE pyproject.toml MANIFEST.in
recursive-include src/parquet_decision *.py *.md *.json *.parquet
recursive-include docs *.md
recursive-include tests *.py
recursive-include examples *.md *.parquet *.json
recursive-include evidence *.md *.json *.txt
recursive-include .github *.yml
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod]
